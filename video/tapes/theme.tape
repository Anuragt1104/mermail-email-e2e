Set Shell "zsh"
Set FontFamily "Menlo"
Set FontSize 23
Set Width 1920
Set Height 1080
Set Padding 34
Set LineHeight 1.15
Set TypingSpeed 38ms
Set Theme { "name": "Mermail Ink", "black": "#0b2a2f", "red": "#ff6b6b", "green": "#43d17a", "yellow": "#f5b942", "blue": "#6aa7ff", "magenta": "#c792ea", "cyan": "#43C9CB", "white": "#d7eeee", "brightBlack": "#5f8a8d", "brightRed": "#ff8787", "brightGreen": "#69e095", "brightYellow": "#ffd479", "brightBlue": "#8fbcff", "brightMagenta": "#dcb3ff", "brightCyan": "#7fe3e4", "brightWhite": "#ffffff", "background": "#07191C", "foreground": "#e6f4f4", "selection": "#16444a", "cursor": "#43C9CB" }
